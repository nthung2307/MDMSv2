<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDMS.HES.Core\MDMS.HES.Core.csproj" />
    <ProjectReference Include="..\MDMS.HES.Application\MDMS.HES.Application.csproj" />
    <ProjectReference Include="..\MDMS.HES.Infrastructure.Simulation\MDMS.HES.Infrastructure.Simulation.csproj" />
    <ProjectReference Include="..\MDMS.HES.Infrastructure.Uplink\MDMS.HES.Infrastructure.Uplink.csproj" />
    <ProjectReference Include="..\MDMS.HES.Infrastructure.OpcDa\MDMS.HES.Infrastructure.OpcDa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="meters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
