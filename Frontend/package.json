{
  "name": "amr-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "vite --port 3000 --mode development ",
    "build:dev": "tsc && vite build --mode development",
    "build:uat": "tsc && vite build --mode uat",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "check": "run-p check:*",
    "check:lint": "eslint . --ext ts,tsx --max-warnings 0",
    "check:format": "prettier --check --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css,scss,sass}'",
    "fix": "run-p fix:*",
    "fix:lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "fix:format": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css,scss,sass}'"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.18.3",
    "axios": "^1.7.2",
    "axios-retry": "^4.4.1",
    "dotenv": "^16.4.5",
    "jotai": "^2.9.3",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^3.1.2",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-number-format": "^5.4.0",
    "react-router-dom": "^6.24.0",
    "react-toastify": "^10.0.5",
    "recoil": "^0.7.7",
    "rxjs": "^7.8.1",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "husky": "8.0.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "prettier": "3.3.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
