# ==============================================================================
# DOCKERFILE CHO FRONTEND MDMSv2 (REACT 18 + VITE + NGINX RUNTIME)
# Multi-stage build tối ưu hiệu năng và an toàn sản xuất
# ==============================================================================

# STAGE 1: Build Production Bundle
FROM node:20-alpine AS builder
WORKDIR /app

# Cài đặt dependencies (tối ưu hóa Docker Layer Cache)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy toàn bộ mã nguồn Frontend
COPY . .

# Biên dịch ứng dụng cho môi trường Production
RUN npm run build:prod

# STAGE 2: Production Nginx Server
FROM nginx:1.27-alpine AS runner

# Xóa trang html mặc định của Nginx
RUN rm -rf /usr/share/nginx/html/*

# Copy file cấu hình Nginx tùy chỉnh hỗ trợ SPA HTML5 History Mode & Proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static bundle từ builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
EXPOSE 8866

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
